	"authors": [
		"1TheCrazy",
		"Aksu Lightning"
	],
	"contact": {
		"sources": "https://github.com/aksulightning/AllTheModels",
		"homepage": "https://github.com/aksulightning/AllTheModels"
	},
	"license": "MIT",
	"icon": "assets/all-the-models/icon.png",
